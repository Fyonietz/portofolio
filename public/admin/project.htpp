<!DOCTYPE html>
<html lang="en">
<head>
  @meta(title="Admin Dashboard")
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portfolio</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/alpinejs@2.8.2/dist/alpine.min.js" defer></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Roboto+Mono:ital,wght@0,100..700;1,100..700&display=swap" rel="stylesheet">``
@meta;
</head>

<body class="bg-beige text-charcoal font-poppins">
  @header(link="/about")
  <!-- Navbar -->
    <header class="bg-crimson p-4 shadow-md fixed top-0 left-0 w-full z-50 ">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <!-- Logo -->
            <div class="text-white text-2xl font-semibold">
               Habib Herdiansyah
            </div>

            <!-- Navigation Links -->
            <nav class="space-x-6">
          <a href='/' class="text-gold hover:text-gray-300 transition duration-300">Home</a>
          <a href='/about' class="text-gold hover:text-gray-300 transition duration-300">About</a>
                <a href="#" class="text-gold hover:text-gray-300 transition duration-300">Services</a>
                <a href="#" class="text-gold hover:text-gray-300 transition duration-300">Contact</a>
            </nav>

            <!-- Mobile Menu Button (optional) -->
            <div class="lg:hidden">
                <button class="text-white">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-6 h-6">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                </button>
            </div>
        </div>
    </header>
@header;

  <!-- AlpineJS Layout -->
  <div class="flex min-h-screen pt-24" x-data="{
    tab: 'add',
    projects: [],
    loadProjects() {
      fetch('/admin/project/lists')
        .then(res => res.json())
        .then(data => this.projects = data)
        .catch(err => console.error('Fetch failed', err));
    },
    deleteProject(id) {
      if (!confirm('Are you sure you want to delete this project?')) return;
      fetch('/admin/project/delete', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ id })
      })
      .then(res => {
        if (!res.ok) throw new Error('Failed to delete');
        return res.json();
      })
      .then(() => {
        this.projects = this.projects.filter(p => p.id !== id);
      })
      .catch(err => {
        alert('Error deleting project');
        console.error(err);
      });
    }
  }" style="padding-top:2rem">

    <!-- Sidebar -->
    <aside class="w-64 bg-crimson text-white p-6 space-y-6 hidden md:block">
      <h2 class="text-2xl font-bold mb-6">Menu</h2>
      <nav class="flex flex-col space-y-4">
        <button @click="tab = 'add'" class="text-left hover:text-gold transition">➕ Add Project</button>
        <button @click="tab = 'list'; loadProjects()" class="text-left hover:text-gold transition">📁 Project List</button>
        <a href="#" class="hover:text-gold">🚪 Logout</a>
      </nav>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 p-8 space-y-12">

      <!-- Add Project Tab -->
      <div x-show="tab === 'add'" x-transition>
        <h1 class="text-4xl font-bold text-crimson mb-8 head text-center">Add New Project</h1>
        <div class="bg-white shadow-lg rounded-lg max-w-2xl mx-auto p-6">
          <form id="project-form" method="POST">
            <div class="mb-6">
              <label for="title" class="block text-sm font-medium text-charcoal">Project Name</label>
              <input type="text" id="title" name="title"
                class="mt-2 w-full p-3 border border-olive rounded-md focus:ring-2 focus:ring-olive focus:border-olive"
                placeholder="Enter project title" required />
            </div>
            <div class="mb-6">
              <label for="description" class="block text-sm font-medium text-charcoal">Project Description</label>
              <textarea id="description" name="description"
                class="mt-2 w-full p-3 border border-olive rounded-md focus:ring-2 focus:ring-olive focus:border-olive"
                placeholder="Enter project description" required></textarea>
            </div>
            <div class="mb-6">
              <label for="link" class="block text-sm font-medium text-charcoal">Project Link (Optional)</label>
              <input type="url" id="link" name="link"
                class="mt-2 w-full p-3 border border-olive rounded-md focus:ring-2 focus:ring-olive focus:border-olive"
                placeholder="Enter project link" />
            </div>
            <div class="flex justify-center">
              <button type="submit"
                class="bg-gold text-white px-6 py-3 rounded-md hover:bg-gold/90 transition">Add Project</button>
            </div>
          </form>
        </div>
      </div>

      <!-- Project List Tab -->
      <div x-show="tab === 'list'" x-transition>
        <h1 class="text-4xl font-bold text-crimson mb-8 head text-center">Project List</h1>
        <div class="overflow-x-auto bg-white shadow-lg rounded-lg p-6">
          <template x-if="projects.length > 0">
            <table class="min-w-full table-auto border-collapse">
              <thead>
                <tr class="bg-olive text-white">
                  <th class="py-3 px-4 text-left">#</th>
                  <th class="py-3 px-4 text-left">Title</th>
                  <th class="py-3 px-4 text-left">Description</th>
                  <th class="py-3 px-4 text-left">Link</th>
                  <th class="py-3 px-4 text-left">Actions</th>
                </tr>
              </thead>
              <tbody>
                <template x-for="(project, index) in projects" :key="project.id">
                  <tr class="border-t hover:bg-gray-50">
                    <td class="py-2 px-4" x-text="index + 1"></td>
                    <td class="py-2 px-4" x-text="project.title"></td>
                    <td class="py-2 px-4" x-text="project.desc"></td>
                    <td class="py-2 px-4">
                      <a :href="project.link" target="_blank" class="text-blue-600 underline">Visit</a>
                    </td>
                    <td class="py-2 px-4 space-x-2">
                      <button @click="deleteProject(project.id)"
                        class="bg-crimson text-white px-3 py-1 rounded hover:bg-red-700">Delete</button>
                    </td>
                  </tr>
                </template>
              </tbody>
            </table>
          </template>
          <template x-if="projects.length === 0">
            <div class="text-center text-gray-500">No projects found.</div>
          </template>
        </div>
      </div>

    </main>
  </div>

  <!-- Styles -->
  @style
    <style>
       /* Font Style */
        body {
            font-family: 'Poppins', 'Roboto Mono', monospace;
        }
        .pto{
         background-color: #DC143C !important;
        background-size: 3% !important; /* Make the background smaller */
          background-position: 15% -10% !important; /* Position it to the left and bottom */
        background-repeat: no-repeat !important;
         margin-left: 15% !important;
         margin-bottom: -10% !important;
        }
    .staircase-section {
    display: flex;
    min-height: 100vh;
    background-color: #2a2a2a; /* Charcoal background */
    justify-content: center;
    align-items: center;
    padding: 0 10px;
    overflow: hidden;
  }

  /* Left Column */
  .left-column {
    width: 50%;
    height: 100%;
    display: flex;
    margin-left: 10%;
    align-items: start;
    justify-content: center;
    flex-direction: column;
    color: white;
    padding: 20px;
  }
  .left-column h1{
    font-family: 'Bebas Neue',monospace;
    font-size: 7rem;
  }
  .left-column button{
    background-color: #DC143C;
    width: 40%;
    height: 50px;
    border-radius: 3%;
   font-size: larger;
  }
  /* Right Column (Holds Crimson Background and Photo) */
  .right-column {
    position: relative;
    width: 50%;
    padding: 20px;
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }

.crimson-background {
    background-color: #DC143C;
    position: absolute;
    z-index: 0;
    width: 70%;
    height: 63%;
    bottom: 10%;
    right: -10%;
    overflow: hidden;
}
  /* Photo styling */
  .photo {
    width: 80%;
    position: relative;
    z-index: 1; /* Ensure the image appears above the crimson background */
    margin-top: 20%;
    margin-right: -50%;
    transition: transform 0.3s ease-in-out;
  }

  /* Optional hover effect on photo */
  .photo:hover {
    transform: scale(1.05); /* Adds a slight zoom effect */
  }

  /* Responsive Styles */
  @media screen and (max-width: 768px) {
    .staircase-section {
      flex-direction: column; /* Stack columns vertically on smaller screens */
      padding: 20px;
      margin-top: 10%;
    }

    .left-column, .right-column {
      width: 100%;
      padding: 15px;
    }
    .left-column{
      align-items: center;
       margin-left: 0px !important;
    }
    .left-column h1{
      font-size: 6rem;
      text-align: center;
     
    }
    .crimson-background {
      width: 50vw !important; /* Adjust background size for smaller screens */
      height: 40vh !important;
      top: 25% !important;
      left: 0vw !important;
    }

    .photo {
      width: 90%;
      margin-top: 20%; /* Adjust photo positioning on smaller screens */
      margin-left: 5%;
    }
  }

  @media screen and (max-width: 480px) {
    .crimson-background {
      width: 60%; /* Further adjust the crimson background on very small screens */
      height: 60%;
      top: 5%;
      left: 10%;
    }

    .photo {
      width: 90%;
      margin-top: 10%; /* Adjust photo margin for even smaller screens */
      margin-left: 5%;
    }
  }
        .head {
            word-spacing: 0.5rem;
            font-family: 'Bebas Neue', monospace;
        }

        /* Custom Colors */
        .bg-crimson {
            background-color: #DC143C;
        }
        .text-crimson {
            color: #DC143C;
        }
        .bg-gold {
            background-color: #FFD700;
        }
        .text-gold {
            color: #FFD700;
        }
        .bg-olive {
            background-color: #708238;
        }
        .text-olive {
            color: #708238;
        }
        .bg-beige {
            background-color: #F5F5DC;
        }
        .text-charcoal {
            color: #333333;
        }
        .bg-charcoal {
            background-color: #333333;
        }
      </style>
@style;

  <script src="script.js"></script>
</body>
</html>

