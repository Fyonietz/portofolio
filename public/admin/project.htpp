<!DOCTYPE html>
<html lang="en">
<head>
@meta(title="Project")
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Project</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/alpinejs@2.8.2/dist/alpine.min.js" defer></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Roboto+Mono:ital,wght@0,100..700;1,100..700&display=swap" rel="stylesheet">
@meta;
</head>
<body class="bg-beige">

    <section>
   <!-- Main Container -->
    <div class="container mx-auto p-8">
        <h1 class="text-5xl font-bold text-crimson mb-4 text-center tracking-wider head">Add New Project</h1>

        <!-- Form Container -->
        <div class="bg-white shadow-lg rounded-lg max-w-lg mx-auto p-6">
            <form id="project-form">

                <!-- Project Name Input -->
                <div class="mb-6">
                    <label for="title" class="block text-sm font-medium text-charcoal">Project Name</label>
                    <input type="text" id="title" name="title" class="mt-2 block w-full p-3 border border-olive rounded-md focus:ring-2 focus:ring-olive focus:border-olive" placeholder="Enter project title" required>
                </div>

                <!-- Project Description Input -->
                <div class="mb-6">
                    <label for="description" class="block text-sm font-medium text-charcoal">Project Description</label>
                    <textarea id="description" name="description" class="mt-2 block w-full p-3 border border-olive rounded-md focus:ring-2 focus:ring-olive focus:border-olive" placeholder="Enter project description" required></textarea>
                </div>

                <!-- Project Link Input -->
                <div class="mb-6">
                    <label for="link" class="block text-sm font-medium text-charcoal">Project Link (Optional)</label>
                    <input type="url" id="link" name="link" class="mt-2 block w-full p-3 border border-olive rounded-md focus:ring-2 focus:ring-olive focus:border-olive" placeholder="Enter project link (if any)">
                </div>

                <!-- Submit Button -->
                <div class="flex justify-center">
                    <button type="submit" class="bg-gold text-white p-3 rounded-md hover:bg-gold/90 transition duration-200">Add Project</button>
                </div>
            </form>
        </div>
    </div>
    </section>

@style
    <style>
       /* Font Style */
        body {
            font-family: 'Poppins', 'Roboto Mono', monospace;
        }

        .head {
            word-spacing: 0.5rem;
            font-family: 'Bebas Neue', monospace;
        }

        /* Custom Colors */
        .bg-crimson {
            background-color: #DC143C;
        }
        .text-crimson {
            color: #DC143C;
        }
        .bg-gold {
            background-color: #FFD700;
        }
        .text-gold {
            color: #FFD700;
        }
        .bg-olive {
            background-color: #708238;
        }
        .text-olive {
            color: #708238;
        }
        .bg-beige {
            background-color: #F5F5DC;
        }
        .text-charcoal {
            color: #333333;
        }
      </style>
@style;
</body>
</html>